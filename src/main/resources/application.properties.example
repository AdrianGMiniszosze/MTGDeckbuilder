spring.application.name=Mtgdeckbuilder
server.port=${PORT:8080}

# Database Configuration
# Copy this file to application.properties and fill in your values
# Required env vars: DB_PASSWORD
# Optional env vars: DB_URL, DB_USERNAME (defaults shown below)
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5433/mtg_db}
spring.datasource.username=${DB_USERNAME:user}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# Authentication
# Required in web profiles: a random value of at least 32 bytes.
# Generate one with: openssl rand -base64 48
app.security.jwt.secret=${JWT_SECRET}
app.security.jwt.access-token-ttl=PT15M
app.security.jwt.refresh-token-ttl=P7D

# Optional one-time first-admin provisioning; disabled by default.
# Enable temporarily and supply credentials, then disable after startup.
app.security.bootstrap-admin.enabled=${BOOTSTRAP_ADMIN_ENABLED:false}
app.security.bootstrap-admin.username=${BOOTSTRAP_ADMIN_USERNAME:admin}
app.security.bootstrap-admin.email=${BOOTSTRAP_ADMIN_EMAIL:}
app.security.bootstrap-admin.password=${BOOTSTRAP_ADMIN_PASSWORD:}
app.security.bootstrap-admin.name=${BOOTSTRAP_ADMIN_NAME:Administrator}
app.security.bootstrap-admin.country=${BOOTSTRAP_ADMIN_COUNTRY:US}
app.security.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000}

# Public authentication endpoint throttles, stored in PostgreSQL for shared limits.
app.security.rate-limit.enabled=true
app.security.rate-limit.login-limit=20
app.security.rate-limit.login-window=PT5M
app.security.rate-limit.register-limit=10
app.security.rate-limit.register-window=PT1H
app.security.rate-limit.refresh-limit=60
app.security.rate-limit.refresh-window=PT5M
app.security.rate-limit.logout-limit=60
app.security.rate-limit.logout-window=PT5M
app.security.rate-limit.email-verify-limit=20
app.security.rate-limit.email-verify-window=PT1H
app.security.rate-limit.email-resend-limit=5
app.security.rate-limit.email-resend-window=PT1H
app.security.rate-limit.password-reset-request-limit=5
app.security.rate-limit.password-reset-request-window=PT1H
app.security.rate-limit.password-reset-limit=10
app.security.rate-limit.password-reset-window=PT1H
app.security.rate-limit.bucket-retention=PT24H
app.security.rate-limit.cleanup-delay=PT1H

# Email verification and password recovery use a generic SMTP server.
spring.mail.host=${MAIL_HOST:localhost}
spring.mail.port=${MAIL_PORT:1025}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=${MAIL_AUTH:false}
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_STARTTLS:false}
app.security.email.from=${MAIL_FROM:no-reply@mtgdeckbuilder.local}
app.security.email.frontend-base-url=${APP_PUBLIC_URL:http://localhost:3000}
app.security.email.verification-path=/verify-email
app.security.email.password-reset-path=/reset-password
app.security.email.verification-token-ttl=P1D
app.security.email.password-reset-token-ttl=PT1H
app.security.email.token-cleanup-delay=PT1H

# Metrics contain endpoint-only counters; actuator access is admin-only.
management.endpoints.web.exposure.include=health,metrics
management.endpoint.health.show-details=never
management.health.mail.enabled=false

# JPA Configuration
# Dialect is auto-detected from JDBC metadata; pinning it makes Hibernate 6 log HHH90000025.
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.lob.non_contextual_creation=true

# Connection Pool Configuration
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5

# Logging
logging.level.org.springframework.web=DEBUG
logging.level.com.deckbuilder=DEBUG
