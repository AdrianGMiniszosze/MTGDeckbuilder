# Copy this file to .env and fill in your own values.
# The .env file is gitignored and should never be committed.

# PostgreSQL (used by both db and app services in docker-compose.yml)
POSTGRES_DB=mtg_db
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme

# SMTP sink provided by docker-compose; replace with your SMTP provider for deployment.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@mtgdeckbuilder.local
APP_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Test database configuration is not read from this file.
# Tests use Testcontainers, which provisions its own PostgreSQL instance at runtime.
