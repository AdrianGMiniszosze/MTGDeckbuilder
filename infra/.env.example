# Copy this file to .env and fill in your own values.
# The .env file is gitignored and should never be committed.

# PostgreSQL (used by both db and app services in docker-compose.yml)
POSTGRES_DB=mtg_db
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme

# Test database configuration is not read from this file.
# Tests use Testcontainers, which provisions its own PostgreSQL instance at runtime.
